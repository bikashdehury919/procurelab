{
  "name": "e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --project=regression",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports/html",
    "testiny:upload": "tsx utils/testiny/upload-results.ts",
    "summary": "tsx utils/reporting/summary.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && playwright test --list",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
