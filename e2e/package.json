    "@testiny/cli": "^1.41.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1"
  }
